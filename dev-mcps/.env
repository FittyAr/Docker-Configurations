# =============================================================================
# Variables de entorno para docker-compose.yml (stack MCP)
# Copia este archivo a .env y ajusta las rutas a tu máquina.
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux/macOS)
# =============================================================================

# --- Git (Reference) — OBLIGATORIO ---
# Ruta host a la carpeta que contiene (o es) tus repositorios Git.
# Dentro del contenedor se monta en /repos
# Windows (Docker Desktop): usa forward slashes o rutas //c/Users/...
GIT_REPO_PATH=D:/Docker

# Identidad opcional para commits realizados por el agente
# GIT_AUTHOR_NAME=MCP Agent
# GIT_AUTHOR_EMAIL=mcp-agent@localhost
# GIT_COMMITTER_NAME=MCP Agent
# GIT_COMMITTER_EMAIL=mcp-agent@localhost

# Token opcional para remotes HTTPS privados (si usas helpers de auth)
# GIT_TOKEN=

# Directorio SSH opcional (montaje comentado en compose por defecto)
# GIT_SSH_DIR=./data/git-ssh

# --- Playwright — recomendado ---
# Capturas, traces y outputs del navegador (host → /mcp/output)
PLAYWRIGHT_OUTPUT=./data/playwright

# Perfil de navegador / uploads (solo si descomentas los volumes en compose)
# PLAYWRIGHT_USER_DATA=./data/playwright-user-data
# PLAYWRIGHT_UPLOADS=./data/playwright-uploads

# --- .NET Types Explorer — OBLIGATORIO ---
# Carpeta host con proyectos .NET (csproj / solutions)
# Dentro del contenedor: /workspace
DOTNET_PROJECTS=D:/Docker

# Cache NuGet del host (opcional; descomenta volume en compose)
# NUGET_PACKAGES=C:/Users/Usuario/.nuget/packages

# --- Chrome DevTools MCP ---
CHROME_DEVTOOLS_PORT=8000
# CHROME_DEVTOOLS_DATA=./data/chrome-devtools

# --- Astro Docs ---
# No requiere variables: es un MCP remoto en
# https://mcp.docs.astro.build/mcp
