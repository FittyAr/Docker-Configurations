# NVIDIA Turing/Ampere/Ada/Blackwell (GTX 16xx, RTX 20xx/30xx/40xx/50xx):
COMFYUI_IMAGE=yanwk/comfyui-boot:cu130-slim-v2

# Para Pascal/Volta (por ejemplo GTX 10xx), usar en su lugar:
# COMFYUI_IMAGE=yanwk/comfyui-boot:cu126-slim

COMFYUI_PORT=8188
COMFYUI_STORAGE=./storage

# Dejalo vacío al principio. Ejemplos opcionales:
# COMFYUI_CLI_ARGS=--lowvram
# COMFYUI_CLI_ARGS=--disable-smart-memory
COMFYUI_CLI_ARGS=

# Opcional: Hugging Face, para modelos gated/privados.
HF_TOKEN=

# Opcional: solo si usás Partner API nodes de Comfy.
COMFY_API_KEY=
